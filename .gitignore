# Real secrets - never commit. Only .env.example (placeholders) is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venvcheck*/
*.egg-info/

# Node / frontend build
node_modules/
frontend/dist/
frontend/build/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local harness state (not project config)
.claude/

# Logs / local scratch
*.log
*.tmp

# Local data (never commit real documents or DB dumps)
/backups/
/watched-documents/

# Local LLM weights and runtime (tens of GB): the model as downloaded, and
# everything local-models/ builds from it (GGUF, llama.cpp binaries, logs,
# scripts). Never in git.
/models qi/
/local-models/

# Local hand-made backups of scripts/config (e.g. start-orbit-ai.ps1.bak-20261009)
*.bak
*.bak-*
