# Copy this file to .env and fill in real values before running on any
# server reachable by someone other than you. Every dev default below is
# fine for a local laptop demo and intentionally weak otherwise.
#
#   cp .env.example .env
#   # edit .env
#   docker compose up -d --build

# --- Secrets (generate with: openssl rand -hex 32) ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
INTERNAL_AUTH_SECRET=change-me
MINIO_ROOT_USER=orbitia
MINIO_ROOT_PASSWORD=change-me
# Password for `orbitia_app`, the low-privilege role the app actually
# connects as day-to-day (see app/core/migrations.py's
# bootstrap_roles_and_grants and INCIDENTS.md). Different from
# POSTGRES_PASSWORD, which is the schema-owner role used only for
# migrations/backups/restores.
APP_DB_PASSWORD=change-me

# --- Gmail OAuth (optional) ---
# Create a Google OAuth Web application. This URI must match exactly in Cloud Console.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:8081/api/connectivity/gmail/callback
# GMAIL_FRONTEND_REDIRECT_URI=http://localhost:8081/connectivity
# Generate a separate key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This produces 43 random characters for token-at-rest encryption; never reuse a Google secret here.
# GMAIL_TOKEN_ENCRYPTION_KEY=

# --- Network exposure ---
# Only the frontend container is ever meant to be reachable from outside
# the host - postgres/minio/ollama/backend stay on 127.0.0.1 always, not
# configurable here on purpose.
#
# Local demo on this machine only (default): leave both commented out.
# Server reachable from other machines on the LAN/internet:
#   FRONTEND_BIND=0.0.0.0
#   FRONTEND_PORT=80
# FRONTEND_BIND=0.0.0.0
# FRONTEND_PORT=8081

# Real origin(s) the frontend is served from, once you have one - only
# needed for direct API access outside the frontend's own nginx proxy
# (e.g. calling the API from a separate dev server or Swagger UI).
# Comma-separated, no brackets/quotes.
# CORS_ORIGINS=https://orbitia.example.com

# --- Folder auto-import (app/rag/watcher.py) ---
# Any supported file (pdf/xlsx/docx/txt/md) dropped in this host folder
# gets imported and indexed automatically within ~WATCH_FOLDER_INTERVAL
# seconds - no manual upload needed. All files in this one folder share a
# single department/confidentiality; for mixed sensitivity, use separate
# folders (change WATCH_FOLDER_HOST_PATH and restart) or upload those by
# hand instead.
# WATCH_FOLDER_ENABLED=true
# WATCH_FOLDER_HOST_PATH=C:/Users/you/Desktop/test
# WATCH_FOLDER_DEPARTMENT=GENERAL
# WATCH_FOLDER_CONFIDENTIALITY=INTERNAL

# --- Server folder sources (app/services/source_roots.py) ---
# Up to three folders of this PC, mounted READ-ONLY into the backend. Set
# them once: the Director then picks any sub-folder from the app ("Dossier
# du PC"), switches between them, pauses or removes one - without touching
# Docker again. Scanned continuously by the backend itself (no browser tab
# needed). A different disk: ORBIT_SOURCE_ROOT_2=D:\Archives, then restart
# with start-orbit-ai.ps1. Network shares must be mapped by Docker Desktop
# itself (a mapped drive letter is NOT visible to Docker).
# ORBIT_SOURCE_ROOT_1=C:\Users\you\Desktop
# ORBIT_SOURCE_ROOT_2=
# ORBIT_SOURCE_ROOT_3=
# SOURCE_SCAN_INTERVAL_SECONDS=600

# --- Local LLM: Qwen3-30B-A3B-Instruct-2507 (GGUF, llama.cpp) ---
# Path to the local GGUF loaded by start-orbit-ai.ps1 and llama-server.exe.
# Relative paths resolve from the project root. The file stays local and is
# never sent to the frontend.
MODEL_PATH=./local-models/gguf/Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf
# The Windows startup script generates and stores a random key if unset.
# LLM_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:8096
# Load-time parameters (applied by the native llama-server startup script):
# LLM_CONTEXT_SIZE=16384  # fits a 12 GB RTX 3060 (q8_0 KV cache, experts in RAM)
# Optional image model sidecar (start-orbit-ai.ps1 enables it only when both GGUF files are present and ready).
# VISION_ENABLED=false
# VISION_BASE_URL=http://host.docker.internal:8097
# VISION_MODEL_NAME=qwen3-vl-8b
# VISION_TIMEOUT_SECONDS=180
# VISION_MAX_IMAGE_BYTES=8388608
# LLM_GPU_LAYERS=99       # every layer on the GPU; MoE experts stay in RAM (LLM_CPU_MOE)
# LLM_CPU_MOE=48          # layers whose experts stay in RAM (48 = all; lower = more VRAM used)
# LLM_THREADS=8           # CPU threads (prompt processing / CPU layers)
# Memory kept between requests by the native llama-server processes
# (start-orbit-ai.ps1; restart them to apply):
# LLM_CACHE_RAM_MB=2048          # prompt cache in RAM (llama-server default: 8192 per server)
# LLM_SLEEP_IDLE_SECONDS=-1      # -1 = text model always loaded (no reload wait in chat)
# VISION_CACHE_RAM_MB=0          # every image is a new prompt: a cache only wastes RAM
# VISION_SLEEP_IDLE_SECONDS=300  # vision model unloaded after 5 min idle, reloaded on demand (2-20 s)
# Generation parameters (applied by the backend on every request):
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=768

# --- Recherche Web (désactivée par défaut) -----------------------------------
# Les réponses restent rédigées par le modèle LOCAL ; seule la requête de
# recherche (tirée de la question, jamais des documents ni de l'historique)
# part vers le fournisseur. Ces valeurs sont des défauts : le Directeur peut
# les modifier dans Admin › Recherche Web (sauf les clés lues ici).
# Les clés ne sont jamais renvoyées au navigateur ni écrites dans les journaux.
# Ne committez jamais une vraie clé : renseignez-la dans .env (non versionné).
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=brave          # searxng | brave | google
# SearXNG local, sans clé API commerciale. Le service n'expose aucun port hôte.
# Créez une valeur aléatoire robuste (ex. python -c "import secrets; print(secrets.token_hex(32))")
# puis renseignez-la uniquement dans .env, jamais ici.
# SEARXNG_SECRET=
# SEARXNG_IMAGE=searxng/searxng:latest
# SEARXNG_URL=http://searxng:8080
# WEB_SEARCH_TRIGGER=auto            # auto : quand la question l'exige | manual : seulement si l'utilisateur choisit Web/Hybride
# WEB_SEARCH_MAX_RESULTS=5           # 1-10 résultats par recherche
# WEB_SEARCH_FETCH_PAGES=3           # pages de résultats réellement lues (0-5)
# WEB_SEARCH_TIMEOUT_SECONDS=10
# WEB_SEARCH_LANGUAGE=fr             # fr | en | ar
# WEB_SEARCH_COUNTRY=                # code ISO à 2 lettres (ex. TN, FR) ; vide = tous pays
# WEB_SEARCH_CACHE_TTL_SECONDS=3600  # cache des résultats (0 = aucun)
# WEB_SEARCH_MAX_PER_HOUR=60         # plafond de recherches par heure (maîtrise des coûts)
#
# Brave Search API (recommandé) : compte sur https://api-dashboard.search.brave.com,
# abonnement « Search », puis « API Keys ».
# BRAVE_SEARCH_API_KEY=
#
# Google Programmable Search JSON API : FERMÉE aux nouveaux clients, arrêtée
# par Google le 1er janvier 2027 (developers.google.com/custom-search/v1/overview).
# Seulement si votre compte dispose déjà d'une clé et d'un moteur « tout le Web ».
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=           # identifiant « cx » du moteur
